@using EntityLayer.Concrete
@model List<Job>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<table class="table table-bordered">
        <tr>
            <th>Job ID</th>
            <th>Job Name</th>
            <th>Sil</th>
            <th>Güncelle</th>
            <th>Detaylar</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.JobID</td>
                <td>@item.Name</td>
                <td><a href="/Job/DeleteJob/@item.JobID" class="btn btn-outline-danger">Sil</a></td>
                <td><a href="/Job/UpdateJob/@item.JobID" class="btn btn-outline-success">Güncelle</a></td>
                <td><a href="#" class="btn btn-outline-primary">Detaylar</a></td>
            </tr>
	    }
</table>
<a href="/Job/AddJob/" class="btn btn-outline-primary">Yeni Meslek Ekle</a>

