    <AssociationSet Name="FK_Notes_Lectures" Association="Self.FK_Notes_Lectures">
      <End Role="Lectures" EntitySet="Lectures" />
      <End Role="Notes" EntitySet="Notes" />
    </AssociationSet>
    <AssociationSet Name="FK_Notes_Student" Association="Self.FK_Notes_Student">
      <End Role="Student" EntitySet="Students" />
      <End Role="Notes" EntitySet="Notes" />
    </AssociationSet>
    <AssociationSet Name="FK_Student_CLUBS" Association="DbExamStudentModel.FK_Student_CLUBS">
      <End Role="CLUB" EntitySet="CLUBS" />
      <End Role="Student" EntitySet="Students" />
    </AssociationSet>
  </EntityContainer>
  <Association Name="FK_Student_CLUBS">
    <End Type="DbExamStudentModel.CLUB" Role="CLUB" Multiplicity="0..1" />
    <End Type="DbExamStudentModel.Student" Role="Student" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="CLUB">
        <PropertyRef Name="CLUBID" />
      </Principal>
      <Dependent Role="Student">
